# Copia aquest fitxer a .env.local i omple només les variables que necessitis.

# Gemini runtime (per defecte: gemini-3.1-flash-lite-preview)
GOOGLE_API_KEY=
GOOGLE_GENAI_API_KEY=
# Alternativa compatible si prefereixes aquest nom
GEMINI_API_KEY=
GOOGLE_GENAI_MODEL=
# Alternativa compatible si prefereixes aquest nom
GEMINI_MODEL=

# Blog generator LLM
OPENAI_API_KEY=
BLOG_WRITER_PROVIDER=openai
BLOG_WRITER_MODEL=gpt-5

# Publicació del blog
BLOG_PUBLISH_SECRET=
BLOG_PUBLISH_BASE_URL=http://127.0.0.1:9002

# Mesura del web públic (inactiva mentre no hi hagi un ID G-...)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Informe de posicionament i visites
SEARCH_CONSOLE_SITE_URL=sc-domain:summasocial.app
GA4_PROPERTY_ID=547126832
# Token OAuth temporal amb webmasters.readonly i analytics.readonly.
# No el guardis al repositori.
GOOGLE_MARKETING_ACCESS_TOKEN=

# MCP públic de lectura (pilot Stytch; inactiu si falta qualsevol valor)
SUMMA_MCP_RESOURCE=https://staging.example/mcp
SUMMA_MCP_OAUTH_ISSUER=https://example.customers.stytch.dev
SUMMA_MCP_DOCUMENTATION_URL=https://staging.example/docs/mcp
SUMMA_MCP_OAUTH_CLIENT_IDS=connected-app-chatgpt,connected-app-claude
SUMMA_MCP_STYTCH_PROJECT_DOMAIN=https://example.customers.stytch.dev
SUMMA_MCP_STYTCH_PROJECT_ID=
# Secret només de servidor. No el guardis al repositori ni l'exposis al client.
SUMMA_MCP_STYTCH_PROJECT_SECRET=
SUMMA_MCP_PILOT_USER_ID=
SUMMA_MCP_PILOT_ORGANIZATION_ID=
SUMMA_MCP_STYTCH_MEMBER_ID=
SUMMA_MCP_STYTCH_ORGANIZATION_ID=
