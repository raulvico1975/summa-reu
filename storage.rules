rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ════════════════════════════════════════════════════════════════════════════
    // Funcions auxiliars
    // ════════════════════════════════════════════════════════════════════════════

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() &&
        firestore.exists(/databases/(default)/documents/systemSuperAdmins/$(request.auth.uid));
    }

    // Qualsevol membre de l'org pot llegir/escriure (sense checks de role ni flags)
    function isOrgMember(orgId) {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }

    function getMemberRole(orgId) {
      return memberData(orgId).get('role', 'viewer');
    }

    function memberData(orgId) {
      let path = /databases/(default)/documents/organizations/$(orgId)/members/$(request.auth.uid);
      return isSignedIn() && firestore.exists(path) ? firestore.get(path).data : {};
    }

    function hasOperationalOrgAccess(orgId) {
      return isOrgMember(orgId)
        && (getMemberRole(orgId) == 'admin' || getMemberRole(orgId) == 'user');
    }

    function memberPermissionDenied(orgId, permKey) {
      let member = memberData(orgId);
      let overrides = member.get('userOverrides', {});
      return overrides is map ? overrides.get('deny', []).hasAny([permKey]) : false;
    }

    function memberPermissionGranted(orgId, permKey) {
      let member = memberData(orgId);
      let grants = member.get('userGrants', []);
      return grants is list ? grants.hasAny([permKey]) : false;
    }

    function roleDefaultAllowsPermission(orgId, permKey) {
      let role = getMemberRole(orgId);
      return (permKey == 'moviments.read' && role in ['admin', 'user', 'viewer'])
        || (permKey == 'moviments.editar' && role in ['admin', 'user'])
        || (permKey == 'projectes.manage' && role in ['admin', 'user'])
        || (permKey == 'sections.projectes' && role in ['admin', 'user', 'viewer']);
    }

    function canEditMovements(orgId) {
      let member = memberData(orgId);
      return isOrgMember(orgId)
        && !memberPermissionDenied(orgId, 'moviments.editar')
        && (roleDefaultAllowsPermission(orgId, 'moviments.editar')
          || member.get('capabilities', {}).get('moviments.editar', false) == true
          || memberPermissionGranted(orgId, 'moviments.editar'));
    }

    function entitlementSystemConfigCompatible() {
      let path = /databases/(default)/documents/system/entitlements;
      let data = firestore.exists(path) ? firestore.get(path).data : {};
      return data.get('catalogVersion', 0) == 3
        && data.get('enforcementMode', 'invalid') in ['off', 'shadow', 'active'];
    }

    function entitlementEnforcementMode() {
      let path = /databases/(default)/documents/system/entitlements;
      let data = firestore.exists(path) ? firestore.get(path).data : {};
      return data.get('catalogVersion', 0) == 3
          && data.get('enforcementMode', 'invalid') in ['off', 'shadow', 'active']
        ? data.get('enforcementMode', 'active') : 'active';
    }

    function transactionDocumentsOperationallyEnabled(orgId) {
      let orgPath = /databases/(default)/documents/organizations/$(orgId);
      let data = firestore.exists(orgPath) ? firestore.get(orgPath).data : {};
      return firestore.exists(orgPath) && data.get('features', {}).get('transactionDocuments', true) != false;
    }

    function subscriptionSnapshotMatchesCatalogV3(orgId) {
      let subscriptionPath = /databases/(default)/documents/organizations/$(orgId)/subscription/current;
      let data = firestore.exists(subscriptionPath) ? firestore.get(subscriptionPath).data : {};
      let plan = data.get('planId', 'unknown');
      let fingerprint = data.get('catalogFingerprint', 'missing');
      return data.get('catalogVersion', 0) == 3
        && data.get('status', 'cancelled') in ['trial', 'active']
        && (
          (plan == 'control' && fingerprint == 'summa-entitlements-v3-control')
          || (plan == 'management' && fingerprint == 'summa-entitlements-v3-management')
          || (plan == 'complete' && fingerprint == 'summa-entitlements-v3-complete')
        );
    }

    function canMutateTransactionDocuments(orgId) {
      let mode = entitlementEnforcementMode();
      let subscriptionPath = /databases/(default)/documents/organizations/$(orgId)/subscription/current;
      return transactionDocumentsOperationallyEnabled(orgId)
        && ((mode == 'off' || mode == 'shadow')
        || (
          mode == 'active'
          && entitlementSystemConfigCompatible()
          && firestore.exists(subscriptionPath)
          && subscriptionSnapshotMatchesCatalogV3(orgId)
          && firestore.get(subscriptionPath).data.get('planId', 'control') in ['management', 'complete']
        ));
    }

    function hasMovementReadCapability(orgId) {
      return isOrgMember(orgId)
        && !memberPermissionDenied(orgId, 'moviments.read')
        && (roleDefaultAllowsPermission(orgId, 'moviments.read')
          || memberData(orgId).get('capabilities', {}).get('moviments.read', false) == true
          || memberPermissionGranted(orgId, 'moviments.read'));
    }

    function pendingDocumentsOperationallyEnabled(orgId) {
      let orgPath = /databases/(default)/documents/organizations/$(orgId);
      let data = firestore.exists(orgPath) ? firestore.get(orgPath).data : {};
      return data.get('features', {}).get('pendingDocs', false) == true;
    }

    function canMutatePendingDocuments(orgId) {
      let mode = entitlementEnforcementMode();
      let subscriptionPath = /databases/(default)/documents/organizations/$(orgId)/subscription/current;
      return pendingDocumentsOperationallyEnabled(orgId)
        && ((mode == 'off' || mode == 'shadow')
        || (
          mode == 'active'
          && entitlementSystemConfigCompatible()
          && firestore.exists(subscriptionPath)
          && subscriptionSnapshotMatchesCatalogV3(orgId)
          && firestore.get(subscriptionPath).data.get('planId', 'control') == 'complete'
        ));
    }

    function projectModuleOperationallyEnabled(orgId) {
      let orgPath = /databases/(default)/documents/organizations/$(orgId);
      let data = firestore.exists(orgPath) ? firestore.get(orgPath).data : {};
      return data.get('features', {}).get('projectModule', false) == true;
    }

    function hasProjectCapability(orgId) {
      let member = memberData(orgId);
      return isOrgMember(orgId)
        && !memberPermissionDenied(orgId, 'sections.projectes')
        && (roleDefaultAllowsPermission(orgId, 'sections.projectes')
          || member.get('capabilities', {}).get('sections.projectes', false) == true
          || memberPermissionGranted(orgId, 'sections.projectes'))
        && ((
          !memberPermissionDenied(orgId, 'projectes.manage')
          && (roleDefaultAllowsPermission(orgId, 'projectes.manage')
            || member.get('capabilities', {}).get('projectes.manage', false) == true
            || memberPermissionGranted(orgId, 'projectes.manage'))
        ) || (
          !memberPermissionDenied(orgId, 'projectes.expenseInput')
          && (member.get('capabilities', {}).get('projectes.expenseInput', false) == true
            || memberPermissionGranted(orgId, 'projectes.expenseInput'))
        ));
    }

    function canMutateProjects(orgId) {
      let mode = entitlementEnforcementMode();
      let subscriptionPath = /databases/(default)/documents/organizations/$(orgId)/subscription/current;
      return projectModuleOperationallyEnabled(orgId)
        && ((mode == 'off' || mode == 'shadow')
        || (mode == 'active'
          && entitlementSystemConfigCompatible()
          && firestore.exists(subscriptionPath)
          && subscriptionSnapshotMatchesCatalogV3(orgId)
          && firestore.get(subscriptionPath).data.get('planId', 'control') == 'complete'
        ));
    }

    function isOrgAdmin(orgId) {
      return isOrgMember(orgId) && getMemberRole(orgId) == 'admin';
    }

    function isAtMost(maxBytes) {
      return request.resource.size <= maxBytes;
    }

    function isAllowedImage() {
      return request.resource.contentType.matches('image/(jpeg|png|gif|webp)');
    }

    function isPdf() {
      return request.resource.contentType == 'application/pdf';
    }

    function isXml() {
      return request.resource.contentType.matches('application/xml(;.*)?') ||
        request.resource.contentType.matches('text/xml(;.*)?');
    }

    function isOfficeDocument() {
      return request.resource.contentType == 'application/msword' ||
        request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document' ||
        request.resource.contentType == 'application/vnd.ms-excel' ||
        request.resource.contentType == 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet';
    }

    function isAttachableDocument() {
      return isAllowedImage() || isPdf() || isXml() || isOfficeDocument();
    }

    function isReceiptDocument() {
      return isAllowedImage() || isPdf() || isXml();
    }

    function isPlainText() {
      return request.resource.contentType.matches('text/plain(;.*)?');
    }

    // ════════════════════════════════════════════════════════════════════════════
    // i18n translations - SuperAdmin can write, everyone can read
    // ════════════════════════════════════════════════════════════════════════════
    match /i18n/{langFile} {
      // Lectura pública (l'app necessita carregar traduccions)
      allow read: if true;

      // Escriptura només per SuperAdmin
      allow write: if isSuperAdmin();
    }

    // ════════════════════════════════════════════════════════════════════════════
    // Support KB - Bot learning system
    // ════════════════════════════════════════════════════════════════════════════
    match /support-kb/{file} {
      // Lectura: usuaris autenticats (bot route necessita carregar override)
      allow read: if isSignedIn();

      // Escriptura: només SuperAdmin (import API)
      allow write: if isSuperAdmin();
    }

    // Uploads client confirmats: configuració d'org (admin-only)
    match /organizations/{orgId}/logo {
      allow read: if isSuperAdmin() || isOrgMember(orgId);
      allow create, update: if (isSuperAdmin() || isOrgAdmin(orgId))
        && isAllowedImage()
        && isAtMost(2 * 1024 * 1024);
      allow delete: if isSuperAdmin() || isOrgAdmin(orgId);
    }

    match /organizations/{orgId}/signature {
      allow read: if isSuperAdmin() || isOrgMember(orgId);
      allow create, update: if (isSuperAdmin() || isOrgAdmin(orgId))
        && isAllowedImage()
        && isAtMost(1 * 1024 * 1024);
      allow delete: if isSuperAdmin() || isOrgAdmin(orgId);
    }

    // Uploads client confirmats: operativa d'org (admin/user)
    match /organizations/{orgId}/pendingDocuments/{docId}/{fileName} {
      allow read: if isSuperAdmin() || hasMovementReadCapability(orgId);
      allow create, update: if canMutatePendingDocuments(orgId)
        && (isSuperAdmin() || canEditMovements(orgId))
        && isReceiptDocument()
        && isAtMost(15 * 1024 * 1024);
      allow delete: if canMutatePendingDocuments(orgId)
        && (isSuperAdmin() || canEditMovements(orgId));
    }

    match /organizations/{orgId}/documents/{transactionId}/{fileName} {
      allow read: if isSuperAdmin() || hasMovementReadCapability(orgId);
      allow create: if canMutateTransactionDocuments(orgId)
        && (isSuperAdmin() || canEditMovements(orgId))
        && resource == null
        && isAttachableDocument()
        && isAtMost(15 * 1024 * 1024);
      allow update, delete: if false;
    }

    match /organizations/{orgId}/transactions/{transactionId}/{fileName} {
      allow read: if isSuperAdmin() || hasMovementReadCapability(orgId);
      allow create: if canMutateTransactionDocuments(orgId)
        && (isSuperAdmin() || canEditMovements(orgId))
        && resource == null
        && isAttachableDocument()
        && isAtMost(15 * 1024 * 1024);
      allow update, delete: if false;
    }

    match /organizations/{orgId}/offBankExpenses/{expenseId}/{fileName} {
      allow read: if isSuperAdmin() || hasProjectCapability(orgId);
      allow create, update: if canMutateProjects(orgId) && (isSuperAdmin() || hasProjectCapability(orgId))
        && isAttachableDocument()
        && isAtMost(15 * 1024 * 1024);
      allow delete: if canMutateProjects(orgId) && (isSuperAdmin() || hasProjectCapability(orgId));
    }

    match /organizations/{orgId}/expenseReports/{reportId}/{fileName} {
      allow read: if isSuperAdmin() || hasProjectCapability(orgId);
      allow create, update: if canMutateProjects(orgId) && (isSuperAdmin() || hasProjectCapability(orgId))
        && isPdf()
        && isAtMost(15 * 1024 * 1024);
      allow delete: if canMutateProjects(orgId) && (isSuperAdmin() || hasProjectCapability(orgId));
    }

    match /organizations/{orgId}/prebankRemittances/{remittanceId}/{fileName} {
      allow read: if isSuperAdmin() || hasMovementReadCapability(orgId);
      allow create, update: if canMutatePendingDocuments(orgId)
        && (isSuperAdmin() || canEditMovements(orgId))
        && isXml()
        && isAtMost(2 * 1024 * 1024);
      allow delete: if canMutatePendingDocuments(orgId)
        && (isSuperAdmin() || canEditMovements(orgId));
    }

    match /organizations/{orgId}/sepaCollectionRuns/{runId}/{fileName} {
      allow read: if isSuperAdmin() || isOrgMember(orgId);
      allow create, update: if (isSuperAdmin() || hasOperationalOrgAccess(orgId))
        && isXml()
        && isAtMost(2 * 1024 * 1024);
      allow delete: if isSuperAdmin() || hasOperationalOrgAccess(orgId);
    }

    // ════════════════════════════════════════════════════════════════════════════
    // Organitzacions - cap fallback: cada prefix ha de declarar lectura i escriptura.
    // ════════════════════════════════════════════════════════════════════════════
    match /organizations/{orgId}/{allPaths=**} {
      allow read, write: if false;
    }

    // ════════════════════════════════════════════════════════════════════════════
    // Per defecte, denegar tot el que no estigui explícitament permès
    // ════════════════════════════════════════════════════════════════════════════
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
